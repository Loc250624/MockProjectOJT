-- CHỈ DÙNG KHI CODEX XÁC NHẬN LESSON/MEDIA CHƯA CÓ TRƯỜNG DURATION.
-- ĐỔI table/column name theo schema thật.
-- Không chạy file này nguyên trạng.

ALTER TABLE Lessons
    ADD COLUMN video_duration_seconds BIGINT NULL;

