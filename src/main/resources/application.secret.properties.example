# application.secret.properties.example
#
# Copy this file to:
#   src/main/resources/application.secret.properties
#
# Fill in real values only in the copied file. The copied file is git-ignored.
# The same key names can be supplied as OS environment variables in CI or
# production, preferably through a secret manager.

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# Optional. Keep this as the exact origin serving the app.
# Local development example:
# APP_BASE_URL=http://localhost:8080

DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# OpenAI Responses API for the student AI Tutor.
# Keep this value only in your local ignored copy or environment.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional overrides:
# AI_TUTOR_ENABLED=true
# OPENAI_MODEL=gpt-5-mini

# External sandbox code judge endpoint.
# Leave unset until a real sandbox runner is available.
# app.code-judge.endpoint=https://judge.example.internal/submissions
