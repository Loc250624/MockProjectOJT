# application.secret.properties.example
#
# SETUP INSTRUCTIONS
# ------------------
# 1. Copy this file:
#       cp application.secret.properties.example application.secret.properties
# 2. Fill in your actual credentials below.
# 3. application.secret.properties is git-ignored — it will NEVER be committed.
#
# HOW THIS WORKS
# --------------
# Spring Boot loads this file via:
#       spring.config.import=optional:classpath:application.secret.properties
#
# Keys defined here (e.g. GITHUB_CLIENT_ID) are added to the Spring Environment.
# Placeholders in application.properties (e.g. ${GITHUB_CLIENT_ID}) are then
# resolved against those keys.
#
# The same key names work as OS environment variables in CI / production,
# so no separate production configuration is needed.

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# External sandbox code judge endpoint.
# Leave unset until a real sandbox runner is available.
# app.code-judge.endpoint=https://judge.example.internal/submissions
